# Exact public HTTPS origin advertised to MCP/GPT Actions and remote runners.
# Do not include a trailing slash.
WORKGPT_PUBLIC_URL=https://workgpt.example.com

# Generate with: openssl rand -hex 32
WORKGPT_TOKEN=replace-with-a-long-random-secret

# Local address consumed by your existing host reverse proxy.
WORKGPT_HOST_IP=127.0.0.1
WORKGPT_HOST_PORT=8080

RUST_LOG=info
